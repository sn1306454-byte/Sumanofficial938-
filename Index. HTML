<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SUMAN OFFICIAL938 | Official Channel</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#071426;color:#fff}
header{position:sticky;top:0;z-index:10;background:rgba(3,12,25,.94);backdrop-filter:blur(8px);display:flex;justify-content:space-between;align-items:center;padding:15px 6%;border-bottom:1px solid #1d4c73}
.logo{font-size:22px;font-weight:800;color:#ffd36a}
nav a{color:#fff;text-decoration:none;margin-left:22px;font-weight:600}
nav a:hover{color:#ffd36a}
.hero{min-height:78vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:45px 20px;background:radial-gradient(circle at 70% 35%,#194d72 0,#071426 52%,#020814 100%)}
.hero-box{max-width:1000px}
.hero img{width:min(100%,1000px);border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,.5);border:1px solid #315b78}
.btns{margin-top:25px}
.btn{display:inline-block;margin:6px;padding:12px 22px;border-radius:30px;text-decoration:none;font-weight:700}
.primary{background:#ffd36a;color:#071426}.secondary{border:1px solid #ffd36a;color:#ffd36a}
section{padding:70px 7%;text-align:center}
h2{font-size:34px;margin-bottom:15px;color:#ffd36a}
.subtitle{color:#c7d5e3;max-width:700px;margin:0 auto 35px;line-height:1.7}
.cards{display:flex;gap:22px;justify-content:center;flex-wrap:wrap}
.card{width:280px;background:#0d2137;border:1px solid #1d4c73;border-radius:16px;padding:28px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
.card .icon{font-size:36px;margin-bottom:12px}
.card h3{margin-bottom:10px}.card p{color:#b9c8d7;line-height:1.6}
.social a{color:#ffd36a;text-decoration:none;font-weight:700}
footer{background:#020814;text-align:center;padding:25px;color:#9eb0c1}
@media(max-width:700px){header{flex-direction:column;gap:10px}nav a{margin:0 7px;font-size:14px}.hero{min-height:auto}.hero img{border-radius:10px}h2{font-size:28px}}
</style>
</head>
<body>
<header>
  <div class="logo">SUMAN OFFICIAL938</div>
